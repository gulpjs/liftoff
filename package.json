    "is-plain-object": "^5.0.0",
    "rechoir": "^0.8.0",
    "resolve": "^1.20.0"
  },
  "devDependencies": {
    "coffeescript": "^2.6.1",
    "eslint": "10.11.0",
    "eslint-config-gulp": "7.0.0",
    "prettier": "3.9.6"
  },
  "keywords": [
    "command line"
  ]
