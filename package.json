{
  "name": "liftoff",
  "version": "5.0.1",
  "description": "Launch your command line tool with ease.",
  "author": "Gulp Team <team@gulpjs.com> (https://gulpjs.com/)",
  "contributors": [
    "Blaine Bublitz <blaine.bublitz@gmail.com> (https://github.com/phated)",
    "Tyler Kellen <tyler@sleekcode.net> (https://github.com/tkellen)",
    "Takayuki Sato (https://github.com/sttk)"
  ],
  "funding": "https://github.com/sponsors/gulpjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gulpjs/liftoff.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">= 22.15.0"
  },
  "main": "./index.js",
  "files": [
    "index.js",
    "lib",
    "LICENSE"
  ],
  "scripts": {
    "format-check": "prettier . --check",
    "format-write": "prettier . --write",
    "lint": "eslint .",
    "test": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=test/lcov.info \"test/*.js\""
  },
  "dependencies": {
    "extend": "^3.0.2",
